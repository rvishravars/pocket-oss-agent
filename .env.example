# Copy to .env and fill in real values. .env is gitignored; this file is not.

# Required. resume-parser calls Claude for structured extraction.
ANTHROPIC_API_KEY=

# Strongly recommended. Unauthenticated GitHub requests cap at 60/hour,
# which github-repo-investigator exceeds on any real repository. Get one
# with the GitHub CLI already on your machine:
#   gh auth token
GITHUB_TOKEN=
